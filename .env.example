# Google AI Studio API Key (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Edge TTS Voice Options:
# hi-IN-SwaraNeural (Female Hindi)
# hi-IN-MadhurNeural (Male Hindi)
# en-IN-NeerjaNeural (Female Indian English)
DEFAULT_VOICE=hi-IN-SwaraNeural
VOICE_RATE=+10%

# Server Port (7860 is default for Hugging Face Spaces)
PORT=7860

# Composio Integration (https://dashboard.composio.dev/)
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# Supabase Long-term Vector Memory & Caller DB (https://supabase.com/ - Free Tier)
# If left empty, system automatically falls back to local JSON caller_memory.json
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
